DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/restaurant
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000
# Business timezone used for "today" and daily/hourly report grouping
TIMEZONE=Asia/Karachi
# First admin account (created only when the users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Load demo menu, tables, inventory and 30 days of history into an empty database
SEED_DEMO_DATA=true
